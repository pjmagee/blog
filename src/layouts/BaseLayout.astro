---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Masthead from "../components/Masthead.astro";
import Footer from "../components/Footer.astro";
import { pageTitle, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  lead?: string;
  canonical?: string;
  image?: string;
  published?: Date;
  tags?: string[];
  isPost?: boolean;
  pageIndex?: number;
}

const {
  title,
  description = site.description,
  lead,
  canonical,
  image,
  published,
  tags = [],
  isPost = false,
  pageIndex,
} = Astro.props;

const fullTitle = pageTitle(title);
const derivedCanonical = new URL(Astro.url.pathname, site.url).toString().replace(/\/$/, "");
const canonicalUrl = canonical ?? (derivedCanonical || site.url);
const heading = title ?? site.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonicalUrl === site.url ? `${site.url}/` : canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.rss" />
    <link rel="alternate" type="application/atom+xml" title={site.title} href="/feed.atom" />
    <meta name="application-name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl === site.url ? `${site.url}/` : canonicalUrl} />
    {image && <meta property="og:image" content={new URL(image, site.url).toString()} />}
    {description && <meta property="og:description" content={description} />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navigation />
    <Masthead
      title={heading}
      lead={lead}
      image={image}
      published={published}
      tags={tags}
      isPost={isPost}
      pageIndex={pageIndex}
    />
    <main class="container">
      <slot />
    </main>
    <Footer canonical={canonical} />
    {
      site.ga && (
        <script is:inline define:vars={{ ga: site.ga, path: Astro.url.pathname, title: fullTitle }}>
          (function (i, s, o, g, r, a, m) {
            i["GoogleAnalyticsObject"] = r;
            (i[r] =
              i[r] ||
              function () {
                (i[r].q = i[r].q || []).push(arguments);
              }),
              (i[r].l = 1 * new Date());
            (a = s.createElement(o)), (m = s.getElementsByTagName(o)[0]);
            a.async = 1;
            a.src = g;
            m.parentNode.insertBefore(a, m);
          })(window, document, "script", "//www.google-analytics.com/analytics.js", "ga");
          ga("create", ga, "auto");
          ga("send", "pageview", { page: path, title: title });
        </script>
      )
    }
  </body>
</html>
